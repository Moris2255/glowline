{
  "name": "glowline",
  "productName": "Glowline",
  "version": "5.3.3",
  "description": "Glowline - local AI workspace: terminal, chat and studio for local models",
  "author": "Moris2255",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "logo": "python build/logo.py",
    "dist": "node build/alte-installer.js && electron-builder --win nsis",
    "dist:link": "electron-builder --win nsis --config build/link.config.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.glowline.app",
    "productName": "Glowline",
    "copyright": "© 2026 Moris2255",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "proxy.js",
      "konten.js",
      "studio.js",
      "agenten.js",
      "einrichtung.js",
      "erstellen.js",
      "dateien.js",
      "link.js",
      "update.js",
      "fernstudio.js",
      "nacht.js",
      "statistik.js",
      "hoeren.js",
    "terminal.js",
    "cli/**",
      "film.js",
      "auto.js",
      "stimme.py",
      "schnitt.py",
      "preload.js",
      "renderer/**",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
    "cli/**",
      "stimme.py",
      "schnitt.py"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Glowline-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Glowline",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "guid": "416d29d4-9e7c-5ed5-b8df-d8dc74b9417e"
    }
  }
}
